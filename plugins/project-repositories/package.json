{
  "name": "@smp/console-project-repositories",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CES 项目仓库管理",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@smp/console-kit": "file:../../packages/console-kit",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.5",
    "@types/react": "^18.3.18",
    "react": "^18.3.1"
  }
}
